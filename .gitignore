# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Large or generated data: keep results small (CSV) and commit those only
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.pkl
data/raw/

# LaTeX build files (commit the PDFs you link to, not the aux files)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
report/report.pdf

# Working outputs of experiment scripts: regenerated by every run, not committed.
# Figures embedded in log entries are kept in log/figs/<entry>/ (committed).
# Results obtained elsewhere go into experiments/<name>/imported/ (committed).
experiments/*/output/
experiments/*/output_quick/
log/figs/*
!log/figs/*/
!log/figs/.gitkeep
log/figs/quick/

# ... but everything imported from elsewhere is committed, whatever its type
!experiments/*/imported/**

# Log exports (build them with tools/logtool.py export)
/log_*.pdf
/log_*.html

# Editors / OS
.vscode/
.idea/
.DS_Store
